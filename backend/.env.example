# ── Quai Network ──────────────────────────────────────────────────────────────
QUAI_RPC_URL=https://orchard.rpc.quai.network/cyprus1
QUAI_CHAIN_ID=15000
QUAI_NETWORK_NAME=orchard-testnet

# ── Coordinator private key (signs Quai transactions) ─────────────────────────
# Hex private key (without 0x prefix)
COORDINATOR_PRIVATE_KEY=your-hex-private-key

# ── Deployed Quai contract addresses ──────────────────────────────────────────
AGENT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
AGENT_REPUTATION_ADDRESS=0x0000000000000000000000000000000000000000
TASK_COORDINATOR_ADDRESS=0x0000000000000000000000000000000000000000

# ── Quaiscan (block explorer) ─────────────────────────────────────────────────
QUAISCAN_BASE_URL=https://orchard.quaiscan.io
QUAISCAN_API_KEY=

# ── Task creation ─────────────────────────────────────────────────────────────
# Budget in QUAI (18 decimals). Default: 0.5 QUAI
TASK_BUDGET_QUAI=0.5

# ── Venice AI ──────────────────────────────────────────────────────────────────
VENICE_API_KEY=your-venice-api-key
VENICE_BASE_URL=https://api.venice.ai/api/v1

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
