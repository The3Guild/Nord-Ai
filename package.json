{
  "name": "nord-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Quai-native AI agent trust and economic coordination protocol",
  "workspaces": [
    "packages/*",
    "apps/*",
    "agents/*"
  ],
  "scripts": {
    "compile": "hardhat compile",
    "forge:build": "forge build",
    "forge:test": "forge test",
